# EBS 자격증명
EBS_USERNAME=your_ebs_username_here
EBS_PASSWORD=your_ebs_password_here

# EBS 다운로더 저장 폴더 (기본값 C:\EBSe)
# EBS_DOWNLOAD_DIR=C:\EBSe

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=ebs-learning
R2_PUBLIC_URL=https://your-public-r2-url

# Gemini API (번역용, https://aistudio.google.com/apikey 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here
